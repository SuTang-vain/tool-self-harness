# Temp files from validation runs
.tmp-config-*.yaml
.tmp-sandbox-cand-*

# Sandbox (working copy of target skill, regenerated from source)
sandbox/

# Run artifacts (traces, caches - too large and regenerable)
runs/cache/

# OS files
.DS_Store
*.swp
*~
sandbox-minimax-baseline/

# Local reproducible evaluation sandboxes
.experiments/

# Fresh generic benchmark workspaces are regenerated per attempt
runs/general-skills/**/workspace/
# Git-worktree benchmark may create sibling worktrees/backing repos outside workspace/
runs/general-skills/**/backing-*/
runs/general-skills/**/feature-*/
runs/general-skills/**/workspace-*/
runs/general-skills/**/worktree-*/

# Generated local origins for submodule benchmark fixtures
runs/general-skills/**/submodule-origin-*/
